# Backend server port (hosting providers often set PORT automatically)
PORT=3000

# Your GitHub Pages origin; comma-separate additional origins for local testing if needed
ALLOWED_ORIGINS=https://patrickromney.github.io

# SMTP settings from your email provider. For Gmail, use smtp.gmail.com and an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-app-password

# The inbox that should receive portfolio inquiries
CONTACT_TO=patrickromneybuzz97@gmail.com
# Sender address approved by your SMTP provider; often the same as SMTP_USER
CONTACT_FROM=your-email@gmail.com
